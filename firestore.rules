rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'muradhase457@gmail.com';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Users: anyone signed in can read (leaderboard/admin),
    // owner or admin can write.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) || isAdmin();
    }

    // Game config: everyone reads, only admin writes.
    match /config/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Skins added from Admin Panel: everyone reads, only admin writes.
    match /skins/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
